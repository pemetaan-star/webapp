rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/user/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/user/$(request.auth.uid));
    }

    function role() {
      return hasProfile() ? profile().role : '';
    }

    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isEnumerator() { return signedIn() && role() == 'enumerator'; }
    function isLegacySupervisor() { return signedIn() && role() == 'supervisor'; }
    function isCoordinator() { return signedIn() && role() == 'koordinator'; }
    function isAnalyst() { return signedIn() && (role() == 'data analis' || role() == 'data analyst'); }
    function isReviewer() { return isAdmin() || isLegacySupervisor() || isCoordinator() || isAnalyst(); }

    function validWorkflowStage(stage) {
      return isAdmin()
        || (isCoordinator() && stage in ['coordinator_review', 'awaiting_enumerator_signature', 'awaiting_coordinator_completion', 'analyst_review', 'needs_revision'])
        || (isAnalyst() && stage in ['analyst_review', 'finalized', 'needs_revision']);
    }

    function validCoordinates(value) {
      return value is string && value.matches('^-?[0-9]{1,2}(\\.[0-9]{1,8})?,[ ]?-?[0-9]{1,3}(\\.[0-9]{1,8})?$');
    }

    function validCounts(data) {
      return data.estimasiJumlahPopulasi is int && data.estimasiJumlahPopulasi >= 0
        && data.jumlahDiedukasi is int && data.jumlahDiedukasi >= 0;
    }

    function validEnumeratorRevision(data) {
      return data.namaHotspot is string && data.namaHotspot.size() > 0
        && data.kecamatan is string && data.kelurahan is string
        && data.alamat is string
        && validCoordinates(data.koordinat)
        && data.statusHotspot in ['aktif', 'baru', 'tidak_aktif', 'perlu_verifikasi']
        && data.statusVerifikasi is string
        && data.populasiKunci is list
        && data.tipeLokasi is string && data.subTipeLokasi is string
        && data.waktuAktivitas is list
        && validCounts(data)
        && data.catatan is string && data.sumberInformasi is string
        && data.noHpInforman is string && data.keteranganAktivitas is string
        && data.kondisiSaatPemetaan is string
        && data.document is map && data.documents is list
        && data.workflowStage == 'coordinator_review'
        && data.workflowUpdatedByRole == 'enumerator'
        && data.workflowHistory is list
        && data.coordinatorReviewStatus == 'Pending';
    }

    function validSubmission(data) {
      return data.keys().hasAll([
          'enumeratorUid', 'kodeHotspot', 'organisasi', 'namaHotspot',
          'kecamatan', 'kelurahan', 'alamat', 'koordinat', 'statusHotspot',
          'statusVerifikasi', 'populasiKunci', 'tipeLokasi', 'subTipeLokasi',
          'document', 'qcStatus', 'workflowStage', 'createdAt'
        ])
        && data.enumeratorUid == request.auth.uid
        && data.kodeHotspot is string && data.kodeHotspot.size() > 0
        && data.namaHotspot is string && data.namaHotspot.size() > 0
        && data.organisasi in ['lgi', 'igama', 'wamarapa', 'fatayat_nu']
        && data.statusHotspot in ['aktif', 'baru', 'tidak_aktif', 'perlu_verifikasi']
        && data.qcStatus == 'pending'
        && data.workflowStage == 'submitted'
        && validCoordinates(data.koordinat)
        && validCounts(data);
    }

    match /user/{userId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow create: if isEnumerator() && validSubmission(request.resource.data);
      allow read: if signedIn() && (isReviewer() || resource.data.enumeratorUid == request.auth.uid);
      allow delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.enumeratorUid == resource.data.enumeratorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'qcStatus', 'qcKelengkapan', 'qcDuplikasi', 'qcKroscek', 'qcNote',
          'qcNamaPemeriksa', 'qcTanggalPemeriksaan', 'qcDokumenPersetujuan',
          'qcReviewerUid', 'qcReviewedAt', 'coordinatorReviewStatus', 'coordinatorReviewNote',
          'coordinatorReviewKelengkapan', 'coordinatorReviewDuplikasi', 'coordinatorReviewKroscek',
          'coordinatorReviewerUid', 'coordinatorReviewedAt', 'coordinatorReviewerName', 'coordinatorReviewDate',
          'workflowStage', 'workflowUpdatedByRole', 'workflowHistory'
        ])
        && validWorkflowStage(request.resource.data.workflowStage)
        || (isCoordinator()
          && request.resource.data.enumeratorUid == resource.data.enumeratorUid
          && request.resource.data.createdAt == resource.data.createdAt
          && resource.data.workflowStage in ['submitted', 'supervisor_review', 'coordinator_review', 'awaiting_enumerator_signature', 'awaiting_coordinator_completion', 'needs_revision']
          && request.resource.data.coordinatorReviewStatus in ['Valid', 'Pending', 'Perlu perbaikan']
          && (
            (request.resource.data.coordinatorReviewStatus == 'Valid' && request.resource.data.workflowStage == 'analyst_review')
            || (request.resource.data.coordinatorReviewStatus == 'Pending' && request.resource.data.workflowStage in ['coordinator_review', 'awaiting_enumerator_signature'])
            || (request.resource.data.coordinatorReviewStatus == 'Perlu perbaikan' && request.resource.data.workflowStage == 'needs_revision')
          )
          && (request.resource.data.coordinatorReviewStatus != 'Perlu perbaikan' || request.resource.data.coordinatorReviewNote.size() > 0)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'coordinatorReviewStatus', 'coordinatorReviewNote', 'coordinatorReviewKelengkapan',
            'coordinatorReviewDuplikasi', 'coordinatorReviewKroscek', 'coordinatorReviewerUid',
            'coordinatorReviewedAt', 'coordinatorReviewerName', 'coordinatorReviewDate',
            'workflowStage', 'workflowUpdatedByRole', 'workflowHistory'
          ]))
        || (isEnumerator()
          && request.resource.data.enumeratorUid == request.auth.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && resource.data.workflowStage == 'needs_revision'
          && request.resource.data.workflowStage == 'coordinator_review'
          && validEnumeratorRevision(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'namaHotspot', 'kecamatan', 'kelurahan', 'alamat', 'koordinat',
            'statusHotspot', 'statusVerifikasi', 'populasiKunci', 'tipeLokasi',
            'subTipeLokasi', 'tipeLokasiLainnya', 'waktuAktivitas',
            'estimasiJumlahPopulasi', 'jumlahDiedukasi', 'catatan',
            'sumberInformasi', 'noHpInforman', 'keteranganAktivitas',
            'kondisiSaatPemetaan', 'document', 'documents', 'coordinatorReviewStatus',
            'workflowStage', 'workflowUpdatedByRole', 'workflowHistory'
          ]))
        || (isEnumerator()
          && request.resource.data.enumeratorUid == request.auth.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && resource.data.workflowStage == 'awaiting_enumerator_signature'
          && request.resource.data.workflowStage == 'awaiting_coordinator_completion'
          && request.resource.data.workflowUpdatedByRole == 'enumerator'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'workflowStage', 'workflowUpdatedByRole', 'workflowHistory'
          ]))
        || (isAnalyst()
          && request.resource.data.enumeratorUid == resource.data.enumeratorUid
          && request.resource.data.createdAt == resource.data.createdAt
          && resource.data.workflowStage == 'analyst_review'
          && request.resource.data.qcStatus in ['valid', 'pending', 'perlu_perbaikan']
          && (
            (request.resource.data.qcStatus == 'valid' && request.resource.data.workflowStage == 'finalized')
            || (request.resource.data.qcStatus == 'pending' && request.resource.data.workflowStage == 'analyst_review')
            || (request.resource.data.qcStatus == 'perlu_perbaikan' && request.resource.data.workflowStage == 'needs_revision')
          )
          && (request.resource.data.qcStatus != 'perlu_perbaikan' || request.resource.data.qcNote.size() > 0)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'qcStatus', 'qcKelengkapan', 'qcDuplikasi', 'qcKroscek', 'qcNote',
            'qcNamaPemeriksa', 'qcTanggalPemeriksaan', 'qcDokumenPersetujuan',
            'qcReviewerUid', 'qcReviewedAt', 'workflowStage', 'workflowUpdatedByRole', 'workflowHistory'
          ]));
    }

    match /supervisions/{supervisionId} {
      allow create: if (isCoordinator() || isAdmin())
        && request.resource.data.coordinatorUid == request.auth.uid
        && request.resource.data.enumeratorUid is string
        && request.resource.data.enumeratorUid.size() > 0
        && request.resource.data.workflowStage == 'coordinator_review'
        && request.resource.data.workflowStatus == 'awaiting_enumerator_signature'
        && request.resource.data.checks is map
        && request.resource.data.submissionIds is list
        && request.resource.data.submissionIds.size() > 0
        && request.resource.data.submissionIds.size() <= 499
        && request.resource.data.checks.keys().size() == 12
        && request.resource.data.pengesahanTandaTanganKoordinator.signerUid == request.auth.uid
        && request.resource.data.pengesahanTandaTanganKoordinator.fileId is string;
      allow read: if isReviewer() || (signedIn() && resource.data.enumeratorUid == request.auth.uid);
      allow update: if isAdmin()
        || (isEnumerator()
          && resource.data.enumeratorUid == request.auth.uid
          && resource.data.workflowStatus == 'awaiting_enumerator_signature'
          && request.resource.data.workflowStatus == 'awaiting_coordinator_completion'
          && request.resource.data.pengesahanEnumeratorHadir == true
          && request.resource.data.pengesahanTandaTanganEnumerator.signerUid == request.auth.uid
          && request.resource.data.pengesahanTandaTanganEnumerator.fileId is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pengesahanNamaEnumerator', 'pengesahanTanggalEnumerator', 'pengesahanEnumeratorHadir',
            'pengesahanTandaTanganEnumerator', 'workflowStatus'
          ]))
        || (isCoordinator()
          && resource.data.coordinatorUid == request.auth.uid
          && resource.data.workflowStatus == 'awaiting_coordinator_completion'
          && request.resource.data.workflowStatus == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workflowStatus', 'completedAt']));
      allow delete: if isAdmin();
    }
  }
}
